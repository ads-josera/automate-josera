# OS/editor noise.
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local development.
.ddev/
.env
.env.*
!.env.example

# Composer-managed dependencies and scaffolded code.
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Drupal runtime files.
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/tmp/
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/settings.ddev.php
/web/sites/*/services.yml

# Keep Drupal examples and default templates versionable.
!/web/sites/*/default.settings.php
!/web/sites/*/default.services.yml

# Generated caches, logs, backups, and database dumps.
/web/sites/*/files/css/
/web/sites/*/files/js/
/web/sites/*/files/php/
*.log
*.sql
*.sql.gz
*.mysql
*.dump
*.tar
*.tar.gz
*.tgz
*.zip
*.bak
*.backup

