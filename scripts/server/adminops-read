#!/usr/bin/env bash
# Forced command for the adminops_observer key (AI AdminOps monitoring).
# Installed as /usr/local/sbin/adminops-read, root:root 755. Read only: each
# check prints one JSON object. Versioned in the repo (scripts/server/).
# 2026-10-13: per-account checks (accounts, mail, processes) for phase C;
# CPU per account measured over 3 s as a share of the whole server.
# 2026-10-11: get_last_action (outcome of Sentinel's last action); Exim
# through a single sudo rule (active and frozen apart), real SSL readings, and a
# reboot check.
set -euo pipefail

# Domains whose certificates get_ssl_status reads, one per line.
SSL_DOMAINS_FILE=/etc/adminops/ssl-domains

case "${SSH_ORIGINAL_COMMAND:-}" in
  'adminops-read get_server_load')
    awk '{printf "{\"status\":\"ok\",\"load_1m\":%s,\"load_5m\":%s,\"load_15m\":%s}\n", $1, $2, $3}' /proc/loadavg
    ;;
  'adminops-read get_cpu_usage')
    read -r _ u1 n1 s1 i1 w1 irq1 sirq1 st1 _ < /proc/stat
    total1=$((u1 + n1 + s1 + i1 + w1 + irq1 + sirq1 + st1))
    idle1=$((i1 + w1))
    sleep 1
    read -r _ u2 n2 s2 i2 w2 irq2 sirq2 st2 _ < /proc/stat
    total2=$((u2 + n2 + s2 + i2 + w2 + irq2 + sirq2 + st2))
    idle2=$((i2 + w2))
    delta_total=$((total2 - total1))
    delta_idle=$((idle2 - idle1))
    awk -v total="$delta_total" -v idle="$delta_idle" 'BEGIN {
      if (total <= 0) { usage = 0 } else { usage = (total - idle) * 100 / total }
      printf "{\"status\":\"ok\",\"cpu_percent\":%.2f}\n", usage
    }'
    ;;
  'adminops-read get_memory_usage')
    awk '/MemTotal:/ {total=$2} /MemAvailable:/ {available=$2} END {
      used=total-available
      printf "{\"status\":\"ok\",\"total_kb\":%d,\"used_kb\":%d,\"used_percent\":%.2f}\n", total, used, (used * 100 / total)
    }' /proc/meminfo
    ;;
  'adminops-read get_disk_usage')
    df -Pk / | awk 'NR==2 {
      gsub("%", "", $5)
      printf "{\"status\":\"ok\",\"mount\":\"/\",\"used_percent\":%d,\"available_kb\":%d}\n", $5, $4
    }'
    ;;
  'adminops-read get_exim_queue')
    # Only root can read the queue; sudoers allows exactly "exim -bp".
    # Frozen messages (2026-10-11: ~530 bounces to the hostname, always
    # there) are not a delivery backlog, so queue_count, the value alerts
    # read, counts only the active ones; the frozen are reported apart.
    if listing=$(sudo -n /usr/sbin/exim -bp 2>/dev/null); then
      printf '%s\n' "$listing" | awk '
        /^ *[0-9]+[mhd] / { total++; if (/\*\*\* frozen \*\*\*/) frozen++ }
        END { printf "{\"status\":\"ok\",\"queue_count\":%d,\"frozen_count\":%d,\"total_count\":%d}\n", total - frozen, frozen, total }'
    else
      printf '{"status":"unavailable"}\n'
    fi
    ;;
  'adminops-read get_ssl_status')
    if [ ! -r "$SSL_DOMAINS_FILE" ]; then
      printf '{"status":"not_configured","message":"No SSL domains listed in %s."}\n' "$SSL_DOMAINS_FILE"
      exit 0
    fi
    now=$(date +%s)
    items=''
    min=''
    while IFS= read -r domain; do
      domain=${domain%%#*}
      domain=$(printf '%s' "$domain" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
      # Plain host names only: the value ends up in JSON and in openssl.
      [[ "$domain" =~ ^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$ ]] || continue
      pem=$(timeout 10 openssl s_client -connect 127.0.0.1:443 -servername "$domain" </dev/null 2>/dev/null | openssl x509 2>/dev/null || true)
      if [ -z "$pem" ]; then
        item=$(printf '{"domain":"%s","status":"unavailable"}' "$domain")
      else
        end=$(printf '%s\n' "$pem" | openssl x509 -noout -enddate | cut -d= -f2)
        days=$(( ($(date -d "$end" +%s) - now) / 86400 ))
        matches=false
        printf '%s\n' "$pem" | openssl x509 -noout -checkhost "$domain" 2>/dev/null | grep -q 'does match' && matches=true
        item=$(printf '{"domain":"%s","days_left":%d,"matches_domain":%s}' "$domain" "$days" "$matches")
        # A certificate for another name (the server's default) says
        # nothing about this domain's own: it is listed, not counted.
        if [ "$matches" = true ] && { [ -z "$min" ] || [ "$days" -lt "$min" ]; }; then min=$days; fi
      fi
      items="${items:+$items,}$item"
    done < "$SSL_DOMAINS_FILE"
    if [ -z "$min" ]; then
      printf '{"status":"unavailable","certificates":[%s]}\n' "$items"
    else
      printf '{"status":"ok","min_days_left":%d,"certificates":[%s]}\n' "$min" "$items"
    fi
    ;;
  'adminops-read get_reboot_status')
    running=$(uname -r)
    installed=$(rpm -q --last kernel-core 2>/dev/null | head -1 | awk '{print $1}' | sed 's/^kernel-core-//' || true)
    rc=0
    report=$(needs-restarting -r 2>/dev/null) || rc=$?
    case "$rc" in
      0) required=false ;;
      1) required=true ;;
      *) printf '{"status":"unavailable","running_kernel":"%s"}\n' "$running"; exit 0 ;;
    esac
    # Which updated packages ask for it ("  * glibc" lines). The kernel can
    # be current and a reboot still due for glibc, systemd, openssl...
    packages=$(printf '%s\n' "$report" | sed -n 's/^ *\* *\([A-Za-z0-9._+-]*\).*/"\1"/p' | head -10 | paste -sd, -)
    printf '{"status":"ok","reboot_required":%s,"updated_packages":[%s],"running_kernel":"%s","newest_installed_kernel":"%s"}\n' "$required" "$packages" "$running" "$installed"
    ;;
  'adminops-read get_accounts')
    # cPanel accounts with disk and quota (phase C). Only root may ask WHM;
    # sudoers allows exactly this helper call.
    sudo -n /usr/local/sbin/adminops-whm-read accounts 2>/dev/null || printf '{"status":"unavailable"}\n'
    ;;
  'adminops-read get_mail_by_account')
    # Mail sent, delivered, failed and deferred per user, last hour and day.
    sudo -n /usr/local/sbin/adminops-whm-read mail 2>/dev/null || printf '{"status":"unavailable"}\n'
    ;;
  'adminops-read get_account_processes')
    # CPU and memory per system user. CPU is measured over SAMPLE seconds
    # from /proc (ticks used between two snapshots) and given as a share of
    # the WHOLE server, like get_cpu_usage. Until 2026-10-13 it came from
    # "ps -o pcpu": each process's lifetime average, on a one-core scale (a
    # busy core read 102 % on this 4-core server). Names outside
    # [A-Za-z0-9._-] are skipped: they go into JSON.
    sample=3
    snapshot() {
      local stat pid line rest
      for stat in /proc/[0-9]*/stat; do
        { read -r line < "$stat"; } 2>/dev/null || continue
        pid=${stat#/proc/}; pid=${pid%/stat}
        # Fields after the command name, which may hold spaces: utime and
        # stime are the 12th and 13th of them.
        rest=${line##*) }
        set -- $rest
        printf '%s %s\n' "$pid" "$(( ${12} + ${13} ))"
      done
    }
    before=$(snapshot)
    sleep "$sample"
    after=$(snapshot)
    awk -v hz="$(getconf CLK_TCK)" -v cores="$(nproc)" -v secs="$sample" '
      FILENAME == ARGV[1] { t0[$1] = $2; next }
      FILENAME == ARGV[2] { t1[$1] = $2; next }
      $2 ~ /^[A-Za-z0-9._-]+$/ {
        # A process started during the sample used all its ticks in it.
        if ($1 in t1) { used[$2] += t1[$1] - (($1 in t0) ? t0[$1] : 0) }
        mem[$2] += $3; n[$2]++
      }
      END {
        printf "{\"status\":\"ok\",\"sample_seconds\":%d,\"cores\":%d,\"users\":[", secs, cores
        sep = ""
        for (u in n) { printf "%s{\"user\":\"%s\",\"cpu_percent\":%.1f,\"memory_mb\":%d,\"processes\":%d}", sep, u, used[u] * 100 / (hz * secs * cores), mem[u] / 1024, n[u]; sep = "," }
        print "]}"
      }' <(printf '%s\n' "$before") <(printf '%s\n' "$after") <(ps -eo pid=,user:32=,rss=)
    ;;
  'adminops-read get_last_action')
    # Written by adminops-act: the last approved action and how it ended.
    if [ -r /var/lib/adminops/last-action.json ]; then
      head -c 512 /var/lib/adminops/last-action.json
    else
      printf '{"status":"none"}\n'
    fi
    ;;
  *)
    printf '{"status":"denied"}\n' >&2
    exit 64
    ;;
esac
