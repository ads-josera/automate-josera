<?php

/**
 * @file
 * Update hooks for AI AdminOps.
 */

/**
 * Installs the content entity schemas introduced after initial installation.
 */
function ai_adminops_update_10001(): void {
  $definition_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();

  foreach ([
    'ai_adminops_event',
    'ai_adminops_action_request',
    'ai_adminops_tool_execution',
  ] as $entity_type_id) {
    $definition_manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
  }
}

/**
 * Adds safe notification defaults for existing AdminOps installations.
 */
function ai_adminops_update_10002(): string {
  $defaults = [
    'enabled' => TRUE,
    'minimum_severity' => 'warning',
    'cooldown_minutes' => 60,
    'email' => [
      'enabled' => TRUE,
      'recipients' => [],
    ],
    'whatsapp' => [
      'enabled' => FALSE,
      'account_id' => '',
      'recipients' => [],
      'template_sid' => '',
    ],
  ];

  $config = \Drupal::configFactory()->getEditable('ai_adminops.settings');
  $existing = $config->get('notifications');
  $config
    ->set('notifications', array_replace_recursive($defaults, is_array($existing) ? $existing : []))
    ->save();

  return t('Added safe notification defaults for AI AdminOps.');
}

/**
 * Adds default monitoring alert thresholds for existing installations.
 */
function ai_adminops_update_10003(): string {
  $defaults = [
    'enabled' => TRUE,
    'unreachable_enabled' => TRUE,
    'load_1m_warning' => 4,
    'cpu_percent_warning' => 90,
    'memory_percent_warning' => 90,
    'disk_percent_warning' => 85,
    'exim_queue_warning' => 100,
  ];

  $config = \Drupal::configFactory()->getEditable('ai_adminops.settings');
  $existing = $config->get('alerts');
  $config
    ->set('alerts', array_replace($defaults, is_array($existing) ? $existing : []))
    ->save();

  return t('Added monitoring alert defaults for AI AdminOps.');
}

/**
 * Lets the audit log tell a reading without measurements from a success.
 */
function ai_adminops_update_10004(): string {
  $definition = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('ai_adminops_tool_execution')['status'];
  \Drupal::entityDefinitionUpdateManager()->updateFieldStorageDefinition($definition);

  return (string) t('The AdminOps audit log now marks readings that carried no data.');
}

/**
 * Relabels past readings that carried no data, which were logged as successes.
 *
 * Only the status label changes; the stored result is untouched. A single
 * query on purpose: production holds tens of thousands of rows, and the
 * entity API would load each one.
 */
function ai_adminops_update_10005(): string {
  $relabelled = \Drupal::database()->update('ai_adminops_tool_execution')
    ->fields(['status' => 'no_data'])
    ->condition('status', 'succeeded')
    ->condition('result', \Drupal::database()->escapeLike('{"status":"ok"') . '%', 'NOT LIKE')
    ->execute();
  \Drupal::entityTypeManager()->getStorage('ai_adminops_tool_execution')->resetCache();

  return (string) t('@count past AdminOps readings without data are no longer labelled as successes.', ['@count' => $relabelled]);
}

