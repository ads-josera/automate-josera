<?php

/**
 * @file
 * Install, schema and update hooks for AI AdminOps.
 */

/**
 * Implements hook_schema().
 */
function ai_adminops_schema(): array {
  return [
    'ai_adminops_account_usage' => _ai_adminops_account_usage_schema(),
  ];
}

/**
 * Usage of each cPanel account, one row per account and scheduled reading.
 *
 * Phase C2 (2026-10-13). The server has no CloudLinux, so nothing else keeps
 * per-account history; AdminOps keeps 30 days of it (AccountUsageHistory)
 * to answer "has this account been busy this week?" and to set the
 * per-account alert thresholds from real data.
 */
function _ai_adminops_account_usage_schema(): array {
  return [
    'description' => 'Usage of each cPanel account at each scheduled AdminOps reading.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'server' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE, 'description' => 'AdminOps server ID.'],
      'account' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE, 'description' => 'cPanel user.'],
      'read_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'suspended' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'disk_mb' => ['type' => 'float', 'not null' => FALSE],
      'quota_mb' => ['type' => 'float', 'not null' => FALSE, 'description' => 'NULL when unlimited.'],
      'mail_sent' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE, 'description' => 'Sent in the hour before read_at; NULL when not read.'],
      'mail_failed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'mail_deferred' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'mail_limit_reached' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0, 'description' => "WHM's REACHED_MAXEMAILS flag as given; it does not mean mail was held."],
      'mail_hour_limit' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE, 'description' => "The account package's hourly mail limit; NULL when unlimited."],
      'cpu_percent' => ['type' => 'float', 'not null' => FALSE, 'description' => 'At read_at; NULL when not read.'],
      'memory_mb' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'processes' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'server_account_read' => ['server', 'account', 'read_at'],
      'read_at' => ['read_at'],
    ],
  ];
}

/**
 * Installs the content entity schemas introduced after initial installation.
 */
function ai_adminops_update_10001(): void {
  $definition_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();

  foreach ([
    'ai_adminops_event',
    'ai_adminops_action_request',
    'ai_adminops_tool_execution',
  ] as $entity_type_id) {
    $definition_manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
  }
}

/**
 * Adds safe notification defaults for existing AdminOps installations.
 */
function ai_adminops_update_10002(): string {
  $defaults = [
    'enabled' => TRUE,
    'minimum_severity' => 'warning',
    'cooldown_minutes' => 60,
    'email' => [
      'enabled' => TRUE,
      'recipients' => [],
    ],
    'whatsapp' => [
      'enabled' => FALSE,
      'account_id' => '',
      'recipients' => [],
      'template_sid' => '',
    ],
  ];

  $config = \Drupal::configFactory()->getEditable('ai_adminops.settings');
  $existing = $config->get('notifications');
  $config
    ->set('notifications', array_replace_recursive($defaults, is_array($existing) ? $existing : []))
    ->save();

  return t('Added safe notification defaults for AI AdminOps.');
}

/**
 * Adds default monitoring alert thresholds for existing installations.
 */
function ai_adminops_update_10003(): string {
  $defaults = [
    'enabled' => TRUE,
    'unreachable_enabled' => TRUE,
    'load_1m_warning' => 4,
    'cpu_percent_warning' => 90,
    'memory_percent_warning' => 90,
    'disk_percent_warning' => 85,
    'exim_queue_warning' => 100,
  ];

  $config = \Drupal::configFactory()->getEditable('ai_adminops.settings');
  $existing = $config->get('alerts');
  $config
    ->set('alerts', array_replace($defaults, is_array($existing) ? $existing : []))
    ->save();

  return t('Added monitoring alert defaults for AI AdminOps.');
}

/**
 * Lets the audit log tell a reading without measurements from a success.
 */
function ai_adminops_update_10004(): string {
  $definition = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('ai_adminops_tool_execution')['status'];
  \Drupal::entityDefinitionUpdateManager()->updateFieldStorageDefinition($definition);

  return (string) t('The AdminOps audit log now marks readings that carried no data.');
}

/**
 * Relabels past readings that carried no data, which were logged as successes.
 *
 * Only the status label changes; the stored result is untouched. A single
 * query on purpose: production holds tens of thousands of rows, and the
 * entity API would load each one.
 */
function ai_adminops_update_10005(): string {
  $relabelled = \Drupal::database()->update('ai_adminops_tool_execution')
    ->fields(['status' => 'no_data'])
    ->condition('status', 'succeeded')
    ->condition('result', \Drupal::database()->escapeLike('{"status":"ok"') . '%', 'NOT LIKE')
    ->execute();
  \Drupal::entityTypeManager()->getStorage('ai_adminops_tool_execution')->resetCache();

  return (string) t('@count past AdminOps readings without data are no longer labelled as successes.', ['@count' => $relabelled]);
}

/**
 * Requires a problem to persist across readings before it raises an alert.
 *
 * On the production server 24 of 25 load spikes above the threshold were a
 * single reading during the 02:00 backups; two readings in a row filter
 * all of them and keep the one sustained episode.
 */
function ai_adminops_update_10006(): string {
  $config = \Drupal::configFactory()->getEditable('ai_adminops.settings');
  if ($config->get('alerts.consecutive_readings') === NULL) {
    $config->set('alerts.consecutive_readings', 2)->save();
  }

  return (string) t('AdminOps alerts now wait for two readings in a row.');
}


/**
 * Creates the per-account usage history table (phase C2).
 */
function ai_adminops_update_10007(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('ai_adminops_account_usage')) {
    $schema->createTable('ai_adminops_account_usage', _ai_adminops_account_usage_schema());
  }

  return (string) t('AdminOps keeps 30 days of usage per cPanel account.');
}

/**
 * Stores each account's hourly mail limit with its usage.
 *
 * Every cPanel package has its own limit (intec 10, most 50 to 120), and the
 * per-account mail alerts will be measured as a share of it.
 */
function ai_adminops_update_10008(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('ai_adminops_account_usage') && !$schema->fieldExists('ai_adminops_account_usage', 'mail_hour_limit')) {
    $schema->addField('ai_adminops_account_usage', 'mail_hour_limit', _ai_adminops_account_usage_schema()['fields']['mail_hour_limit']);
  }

  return (string) t('AdminOps keeps each account package hourly mail limit with its usage.');
}

/**
 * Adds the alerts about single cPanel accounts and expiring certificates.
 */
function ai_adminops_update_10009(): string {
  $config = \Drupal::configFactory()->getEditable('ai_adminops.settings');
  $alerts = $config->get('alerts') ?: [];
  $alerts += ['ssl_days_warning' => 20];
  $alerts['accounts'] = ($alerts['accounts'] ?? []) + [
    'enabled' => TRUE,
    'mail_percent_warning' => 80,
    'failed_mail_warning' => 10,
    'disk_percent_warning' => 90,
    'cpu_percent_warning' => 50,
    'cpu_consecutive_readings' => 4,
  ];
  $config->set('alerts', $alerts)->save();

  return (string) t('AdminOps alerts about single cPanel accounts and expiring certificates are configured.');
}
