 */
function ai_whatsapp_automation_update_11011(): void {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($definition_update_manager->getFieldStorageDefinition('lead_notification_numbers', 'ai_whatsapp_account') !== NULL) {
