    'ai_whatsapp_knowledge_chunk',
  ] as $entity_type_id) {
    if ($definition_update_manager->getEntityType($entity_type_id) !== NULL) {
      continue;
    }

    $definition_update_manager->installEntityType(
      $entity_type_manager->getDefinition($entity_type_id)
    );
  }
}

/**
 * Installs Evolution QR connection fields on WhatsApp accounts.
 */
function ai_whatsapp_automation_update_11005(): void {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $field_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('ai_whatsapp_account');

  foreach ([
    'evolution_instance_name',
    'connection_status',
    'connected_phone_number',
    'connected_at',
    'last_qr',
    'last_qr_generated',
    'last_status_check',
    'last_error',
  ] as $field_name) {
    if ($definition_update_manager->getFieldStorageDefinition($field_name, 'ai_whatsapp_account') !== NULL) {
      continue;
    }

    $definition_update_manager->installFieldStorageDefinition(
      $field_name,
      'ai_whatsapp_account',
      'ai_whatsapp_automation',
      $field_definitions[$field_name]
    );
  }
}

/**
 * Installs MultiBot routing override fields.
 */
function ai_whatsapp_automation_update_11006(): void {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $field_manager = \Drupal::service('entity_field.manager');

  $fields_by_entity = [
    'ai_whatsapp_bot' => [
      'knowledge_base',
    ],
    'ai_whatsapp_account' => [
      'prompt_override',
      'model_override',
      'knowledge_base',
    ],
  ];

  foreach ($fields_by_entity as $entity_type_id => $field_names) {
    $field_definitions = $field_manager->getFieldStorageDefinitions($entity_type_id);
    foreach ($field_names as $field_name) {
      if ($definition_update_manager->getFieldStorageDefinition($field_name, $entity_type_id) !== NULL) {
        continue;
      }

      $definition_update_manager->installFieldStorageDefinition(
        $field_name,
        $entity_type_id,
        'ai_whatsapp_automation',
        $field_definitions[$field_name]
      );
    }
  }
}

/**
 * Replaces retired OpenAI model IDs with current model IDs.
 */
function ai_whatsapp_automation_update_11007(): void {
  $model_map = [
    'gpt-5.5-mini' => 'gpt-5-mini',
    'gpt-5.5' => 'gpt-5.1',
  ];

  $config = \Drupal::configFactory()->getEditable('ai_whatsapp_automation.settings');
  $default_model = (string) $config->get('openai.default_model');
  if (isset($model_map[$default_model])) {
    $config->set('openai.default_model', $model_map[$default_model])->save();
  }

  $database = \Drupal::database();
  foreach ($model_map as $old_model => $new_model) {
    if ($database->schema()->tableExists('ai_whatsapp_bot')) {
      $database->update('ai_whatsapp_bot')
        ->fields(['model' => $new_model])
        ->condition('model', $old_model)
        ->execute();
    }

    if ($database->schema()->tableExists('ai_whatsapp_account')) {
      $database->update('ai_whatsapp_account')
        ->fields(['model_override' => $new_model])
        ->condition('model_override', $old_model)
        ->execute();
    }
  }

  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $field_manager = \Drupal::service('entity_field.manager');

  foreach ([
    'ai_whatsapp_bot' => 'model',
    'ai_whatsapp_account' => 'model_override',
  ] as $entity_type_id => $field_name) {
    $field_definitions = $field_manager->getFieldStorageDefinitions($entity_type_id);
    if (isset($field_definitions[$field_name])) {
      $definition_update_manager->updateFieldStorageDefinition($field_definitions[$field_name]);
    }
  }
}

/**
 * Adds a default inactivity timeout for AI conversations.
 */
function ai_whatsapp_automation_update_11008(): void {
  $config = \Drupal::configFactory()->getEditable('ai_whatsapp_automation.settings');
  if ($config->get('options.auto_close_ai_hours') === NULL) {
    $config->set('options.auto_close_ai_hours', 24)->save();
  }
}

