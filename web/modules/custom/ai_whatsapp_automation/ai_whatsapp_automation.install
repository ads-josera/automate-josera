/**
 * Initializes configurable OpenAI cost rates.
 */
function ai_whatsapp_automation_update_11018(): void {
  $config = \Drupal::configFactory()->getEditable('ai_whatsapp_automation.settings');
  if ($config->get('openai.cost_rates') === NULL) {
    $config->set('openai.cost_rates', [])->save();
  }
}

/**
 * Converts OpenAI cost rates to a configuration-safe list.
 */
function ai_whatsapp_automation_update_11019(): void {
  $config = \Drupal::configFactory()->getEditable('ai_whatsapp_automation.settings');
  $stored_rates = $config->get('openai.cost_rates');
  if (!is_array($stored_rates)) {
    return;
  }

  $rates = [];
  foreach ($stored_rates as $model => $rate) {
    if (!is_array($rate)) {
      continue;
    }
    $model = trim((string) ($rate['model'] ?? $model));
    if ($model === '') {
      continue;
    }
    $rates[] = [
      'model' => $model,
      'input' => (float) ($rate['input'] ?? 0),
      'output' => (float) ($rate['output'] ?? 0),
    ];
  }

  $config->set('openai.cost_rates', $rates)->save();
}

/**
 * Makes the branded login page the public entry point of the site.
 */
function ai_whatsapp_automation_update_11020(): void {
  \Drupal::configFactory()
    ->getEditable('system.site')
    ->set('page.front', '/user/login')
    ->save();
}

/**
 * Enables the favicon upload control for the branded access theme.
 */
function ai_whatsapp_automation_update_11021(): void {
  $config = \Drupal::configFactory()->getEditable('josera_access.settings');
  $features = (array) $config->get('features');
  $features['favicon'] = TRUE;
  $config
    ->set('features', $features)
    ->set('favicon.use_default', FALSE)
    ->save();
}

/**
 * Adds template variable mappings for lead notification templates.
 */
function ai_whatsapp_automation_update_11022(): void {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $field_manager = \Drupal::service('entity_field.manager');

  foreach (['ai_whatsapp_bot', 'ai_whatsapp_account'] as $entity_type_id) {
    if ($definition_update_manager->getFieldStorageDefinition('lead_notification_template_variables', $entity_type_id) !== NULL) {
      continue;
    }
    $fields = $field_manager->getFieldStorageDefinitions($entity_type_id);
    if (isset($fields['lead_notification_template_variables'])) {
      $definition_update_manager->installFieldStorageDefinition(
        'lead_notification_template_variables',
        $entity_type_id,
        'ai_whatsapp_automation',
        $fields['lead_notification_template_variables']
      );
    }
  }
}

/**
 * Initializes the automatic reply for lead notification recipients.
 */
function ai_whatsapp_automation_update_11023(): void {
  $config = \Drupal::configFactory()->getEditable('ai_whatsapp_automation.settings');
  if ($config->get('options.notification_recipient_reply_text') === NULL) {
    $config->set('options.notification_recipient_reply_text', 'Este número es exclusivo para notificaciones del sistema. No responde mensajes ni solicitudes.')->save();
  }
}

/**
 * Returns the entity type IDs provided by this module.
 *
 * @return string[]
 *   The entity type IDs.
 */
function ai_whatsapp_automation_entity_type_ids(): array {
  return [
    'ai_whatsapp_bot',
    'ai_whatsapp_account',
    'ai_whatsapp_conversation',
    'ai_whatsapp_message',
    'ai_whatsapp_lead',
    'ai_whatsapp_operator_action',
    'ai_whatsapp_knowledge_base',
    'ai_whatsapp_knowledge_document',
    'ai_whatsapp_knowledge_chunk',
  ];
}
