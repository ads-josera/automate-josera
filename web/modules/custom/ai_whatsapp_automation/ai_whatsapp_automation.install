    if (isset($fields['lead_notification_template_sid'])) {
      $definition_update_manager->installFieldStorageDefinition(
        'lead_notification_template_sid',
        $entity_type_id,
        'ai_whatsapp_automation',
        $fields['lead_notification_template_sid']
      );
    }
  }
}

