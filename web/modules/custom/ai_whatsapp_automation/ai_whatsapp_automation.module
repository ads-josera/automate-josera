/**
 * Implements hook_cron().
 */
function ai_whatsapp_automation_cron(): void {
  \Drupal::service('ai_whatsapp_automation.evolution.instance_manager')->monitorAccounts();
  ai_whatsapp_automation_close_stale_conversations();
}

/**
 * Closes AI conversations that have been inactive longer than configured.
 */
function ai_whatsapp_automation_close_stale_conversations(): void {
  $config = \Drupal::config('ai_whatsapp_automation.settings');
  $ttl_hours = (int) ($config->get('options.auto_close_ai_hours') ?? 24);
  if ($ttl_hours <= 0) {
    return;
  }

  $cutoff = \Drupal::time()->getRequestTime() - ($ttl_hours * 3600);
  $storage = \Drupal::entityTypeManager()->getStorage('ai_whatsapp_conversation');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('status', 'AI_ACTIVE')
    ->condition('changed', $cutoff, '<')
    ->range(0, 100)
    ->execute();

  if ($ids === []) {
    return;
  }

  foreach ($storage->loadMultiple($ids) as $conversation) {
    $conversation->set('status', 'CLOSED');
    $conversation->save();
  }

  \Drupal::logger('ai_whatsapp_automation')->notice('Closed @count inactive AI conversations after @hours hours.', [
    '@count' => (string) count($ids),
    '@hours' => (string) $ttl_hours,
  ]);
}

/**
 * Styles the TFA enrollment form when the access theme is active.
 */
function ai_whatsapp_automation_form_tfa_setup_alter(array &$form): void {
  ai_whatsapp_automation_attach_tfa_styles($form);
}

/**
 * Attaches the shared visual treatment for TFA forms.
 */
function ai_whatsapp_automation_attach_tfa_styles(array &$form): void {
  $form['#attached']['library'][] = 'ai_whatsapp_automation/tfa_setup';
  $form['#attributes']['class'][] = 'ai-whatsapp-tfa-setup';
}

/**
 * Uses the administration theme for the multi-step TFA enrollment flow.
 */
function ai_whatsapp_automation_custom_theme(): ?string {
  return match (\Drupal::routeMatch()->getRouteName()) {
    'tfa.validation.setup' => 'claro',
    'tfa.entry' => 'josera_access',
    default => NULL,
  };
}

