  \Drupal::service('ai_whatsapp_automation.client_assignment')->assign($entity);
}

/**
 * Implements hook_file_download().
 *
 * Knowledge documents are client files: only knowledge administrators may
 * download them. Denying here also covers private files that no other module
 * claims.
 */
function ai_whatsapp_automation_file_download(string $uri): array|int|null {
  if (!str_starts_with($uri, 'private://' . KnowledgeFileStorage::DIRECTORY . '/')) {
    return NULL;
  }
  if (!\Drupal::currentUser()->hasPermission('administer ai whatsapp automation rag')) {
    return -1;
  }
  $files = \Drupal::entityTypeManager()->getStorage('file')->loadByProperties(['uri' => $uri]);
  $file = reset($files);
  if (!$file instanceof FileInterface) {
    return -1;
  }

  return [
    'Content-Type' => $file->getMimeType(),
    'Content-Length' => (string) $file->getSize(),
    'Content-Disposition' => 'attachment; filename="' . str_replace('"', '', $file->getFilename()) . '"',
    'Cache-Control' => 'private',
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view() for ai_whatsapp_knowledge_document.
 *
 * Adds a download button: the file field alone shows the file name as plain
 * text because files have no page of their own.
 */
function ai_whatsapp_automation_ai_whatsapp_knowledge_document_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  $url = AutomationEntityListBuilder::documentDownloadUrl($entity);
  if ($url === NULL) {
    return;
  }
  $build['download'] = [
    '#type' => 'link',
    '#title' => t('Descargar documento'),
    '#url' => $url,
    '#attributes' => ['class' => ['button', 'button--primary']],
    '#weight' => -100,
    '#cache' => ['contexts' => ['user.permissions']],
  ];
}

/**
 * Implements hook_entity_base_field_info().
 *
 * The client a user belongs to. Client users only reach that client's
 * records (see ClientAccess).
 */
function ai_whatsapp_automation_entity_base_field_info(EntityTypeInterface $entity_type): array {
  if ($entity_type->id() !== 'user') {
    return [];
  }

  return [
    'ai_whatsapp_client' => BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Cliente de AI WhatsApp'))
      ->setDescription(t('Solo para usuarios de un cliente: verán únicamente sus conversaciones, mensajes, leads y dashboard. Déjalo vacío para el personal interno.'))
      ->setSetting('target_type', 'ai_whatsapp_client')
      ->setSetting('handler', 'default')
      ->setDisplayOptions('form', ['type' => 'options_select', 'weight' => 20])
      ->setDisplayConfigurable('form', TRUE),
  ];
}

/**
 * Implements hook_entity_field_access().
 *
 * Only administrators may see or change which client a user belongs to:
 * a client user editing their own profile must not switch clients.
 */
function ai_whatsapp_automation_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if ($field_definition->getName() !== 'ai_whatsapp_client' || $field_definition->getTargetEntityTypeId() !== 'user') {
    return AccessResult::neutral();
  }

  return AccessResult::forbiddenIf(!$account->hasPermission('administer users') || !$account->hasPermission(ClientAccess::ADMIN_PERMISSION))
    ->cachePerPermissions();
}

/**
 * Implements hook_query_TAG_alter() for ai_whatsapp_conversation_access.
 */
function ai_whatsapp_automation_query_ai_whatsapp_conversation_access_alter(AlterableInterface $query): void {
  _ai_whatsapp_automation_restrict_to_client($query, 'base_table.client');
}

