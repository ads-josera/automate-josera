}

/**
 * Implements hook_query_TAG_alter() for ai_whatsapp_operator_action_access.
 */
function ai_whatsapp_automation_query_ai_whatsapp_operator_action_access_alter(AlterableInterface $query): void {
  _ai_whatsapp_automation_restrict_to_client($query, 'ai_whatsapp_client_conversation.client', 'conversation');
}

/**
 * Restricts an access-checked entity query to the current user's client.
 *
 * Administrators are not restricted. A user without the client permission or
 * without a client gets no rows. Queries run with accessCheck(FALSE) (webhooks,
 * services) carry no access tag and are never restricted.
 *
 * @param \Drupal\Core\Database\Query\AlterableInterface $query
 *   The entity query being built.
 * @param string $client_column
 *   Qualified client column to compare.
 * @param string|null $conversation_column
 *   For records that reach their client through a conversation, the column
 *   of the base table referencing it.
 */
function _ai_whatsapp_automation_restrict_to_client(AlterableInterface $query, string $client_column, ?string $conversation_column = NULL): void {
  if (!$query instanceof SelectInterface) {
    return;
  }
  $account = \Drupal::currentUser();
  $client_access = \Drupal::service('ai_whatsapp_automation.client_access');
  if ($client_access->isAdmin($account)) {
    return;
  }
  $client_id = $account->hasPermission(ClientAccess::VIEW_PERMISSION) ? $client_access->clientId($account) : NULL;
  if ($client_id === NULL) {
    $query->alwaysFalse();
    return;
  }
  if ($conversation_column !== NULL) {
    $query->join('ai_whatsapp_conversation', 'ai_whatsapp_client_conversation', 'ai_whatsapp_client_conversation.id = base_table.' . $conversation_column);
  }
  $query->condition($client_column, $client_id);
}

/**
 * Implements hook_ENTITY_TYPE_view() for ai_whatsapp_lead.
 *
 * Follow-up happens by changing the status; the button leads to the small
 * status form that client users are allowed to use.
 */
function ai_whatsapp_automation_ai_whatsapp_lead_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  $url = Url::fromRoute('ai_whatsapp_automation.lead_status', ['ai_whatsapp_lead' => $entity->id()]);
  $build['status_action'] = [
    '#type' => 'link',
    '#title' => t('Cambiar estado'),
    '#url' => $url,
    '#access' => $url->access(),
    '#attributes' => ['class' => ['button', 'button--primary']],
    '#weight' => -100,
    '#cache' => ['contexts' => ['user']],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 */
function ai_whatsapp_automation_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  if (isset($form['ai_whatsapp_client'])) {
    $form['#validate'][] = '_ai_whatsapp_automation_user_client_validate';
  }
  // Entity forms keep their handlers on the button, not on the form.
  if (isset($form['actions']['submit']['#submit'])) {
    $form['actions']['submit']['#submit'][] = '_ai_whatsapp_automation_account_saved_redirect';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 */
function ai_whatsapp_automation_form_user_register_form_alter(array &$form, FormStateInterface $form_state): void {
  ai_whatsapp_automation_form_user_form_alter($form, $form_state);
}

/**
 * Requires a client for users with the client agent role.
 *
 * Without it the user logs in and sees nothing, with no hint why.
 */
function _ai_whatsapp_automation_user_client_validate(array &$form, FormStateInterface $form_state): void {
  $roles = array_filter((array) $form_state->getValue('roles'));
  $client = $form_state->getValue(['ai_whatsapp_client', 0, 'target_id']);
  if (in_array('ai_whatsapp_client_agent', $roles, TRUE) && empty($client)) {
    $form_state->setErrorByName('ai_whatsapp_client', t('Elige el cliente de AI WhatsApp de este usuario: con el rol «Atención a clientes» y sin cliente no vería ninguna conversación.'));
  }
}


/**
 * Implements hook_theme().
 */
function ai_whatsapp_automation_theme(): array {
  return [
    'ai_whatsapp_client_agent_mail' => [
      'variables' => [
        'heading' => NULL,
        'intro' => NULL,
        'items' => [],
        'action' => NULL,
        'url' => '',
        'note' => NULL,
        'client' => '',
      ],
    ],
  ];
}

/**
 * Implements hook_mail_alter().
 *
 * Rewrites the account e-mails of a client's users: Drupal's English text
 * about "a site administrator" says nothing to somebody who was only given a
 * panel for their own chatbot.
 */
function ai_whatsapp_automation_mail_alter(array &$message): void {
  \Drupal::service('ai_whatsapp_automation.client_agent_mail')->alter($message);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function ai_whatsapp_automation_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#submit'][] = '_ai_whatsapp_automation_login_redirect';
}

/**
 * Sends a client's user straight to their dashboard after logging in.
 *
 * Runs after the login submit handler, so the account is already logged in by
 * then. When a second factor is still pending (TFA) nobody is logged in yet
 * and the redirect TFA set is left untouched.
 */
function _ai_whatsapp_automation_login_redirect(array &$form, FormStateInterface $form_state): void {
  $uid = (int) $form_state->get('uid');
  if ($uid === 0 || (int) \Drupal::currentUser()->id() !== $uid) {
    return;
  }
  _ai_whatsapp_automation_redirect_to_dashboard($form_state, $uid);
}

/**
 * Sends a client's user to the dashboard after saving their own account.
 *
 * This is where the first login ends: the one-time link from the welcome
 * e-mail opens the account form to set a password.
 */
function _ai_whatsapp_automation_account_saved_redirect(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $account = $form_object->getEntity();
  if ((int) $account->id() !== (int) \Drupal::currentUser()->id()) {
    return;
  }
  _ai_whatsapp_automation_redirect_to_dashboard($form_state, (int) $account->id());
}

/**
 * Redirects to the dashboard when the account is a client's user.
 *
 * Anybody else keeps the landing Drupal chose. The dashboard is only offered
 * when the account may actually open it, to never land on an access denied.
 */
function _ai_whatsapp_automation_redirect_to_dashboard(FormStateInterface $form_state, int $uid): void {
  $account = \Drupal::entityTypeManager()->getStorage('user')->load($uid);
  if ($account === NULL || !in_array(ClientAgentMail::ROLE, $account->getRoles(), TRUE)) {
    return;
  }
  $dashboard = Url::fromRoute('ai_whatsapp_automation.dashboard');
  if ($dashboard->access($account)) {
    $form_state->setRedirect('ai_whatsapp_automation.dashboard');
  }
}
