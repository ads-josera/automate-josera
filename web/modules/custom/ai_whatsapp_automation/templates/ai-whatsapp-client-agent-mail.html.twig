{#
/**
 * @file
 * Account e-mail sent to a client's users.
 *
 * Mail clients ignore stylesheets and most modern CSS, so everything is
 * inline and the layout is a single centred table. The palette is the one of
 * the login screen: deep indigo with a pink call to action.
 *
 * Available variables:
 * - heading: title shown inside the card.
 * - intro: opening paragraph.
 * - items: list of what the person can do in the panel; may be empty.
 * - action: label of the button.
 * - url: one-time login link the button points to.
 * - note: small print under the button.
 * - client: name of the client the account belongs to.
 */
#}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ heading }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f8;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0;padding:24px 0;background:#f4f4f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:560px;max-width:100%;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 2px 10px rgba(20,13,46,.08);">
        <tr>
          <td style="padding:28px 32px;background:#1b1140;background-image:linear-gradient(135deg,#1b1140 0%,#2e1f63 100%);">
            <p style="margin:0 0 6px 0;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#b9b3d6;">Josera · Plataforma de automatización</p>
            <p style="margin:0;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#ffffff;font-weight:600;">{{ client }}</p>
          </td>
        </tr>
        <tr>
          <td style="padding:28px 32px 0 32px;">
            <h1 style="margin:0;font-size:22px;line-height:1.3;color:#1b1140;">{{ heading }}</h1>
          </td>
        </tr>
        <tr>
          <td style="padding:12px 32px 0 32px;font-size:15px;line-height:1.6;color:#4a4468;">
            <p style="margin:0;">{{ intro }}</p>
            {% if items %}
              <ul style="margin:16px 0 0 0;padding-left:20px;">
                {% for item in items %}
                  <li style="margin:0 0 8px 0;">{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </td>
        </tr>
        <tr>
          <td style="padding:24px 32px 8px 32px;">
            <a href="{{ url }}" style="display:inline-block;padding:13px 26px;background:#ec1e63;color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;border-radius:10px;">{{ action }}</a>
          </td>
        </tr>
        <tr>
          <td style="padding:8px 32px 28px 32px;font-size:13px;line-height:1.6;color:#7a7395;">
            <p style="margin:0;">{{ note }}</p>
            <p style="margin:12px 0 0 0;">{{ 'Si el botón no funciona, copia esta dirección en tu navegador:'|t }}<br>
              <span style="word-break:break-all;color:#4a4468;">{{ url }}</span>
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
