  'entity.ai_whatsapp_account.collection' => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3.5h8v17H8zM11 18h2"/></svg>',
  'ai_whatsapp_automation.multibot_routing' => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h5v5H5zM14 14h5v5h-5zM7.5 10v4.5H14"/></svg>',
  'entity.ai_whatsapp_knowledge_base.collection' => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h9a2 2 0 0 1 2 2V20a2 2 0 0 0-2-2H5V4.5ZM19 6v14"/></svg>',
