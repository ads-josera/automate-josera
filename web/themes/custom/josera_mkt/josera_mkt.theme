  'entity.ai_whatsapp_lead.collection' => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.7 5.6 6.1.9-4.4 4.3 1 6.2-5.4-2.9-5.4 2.9 1-6.2L3.2 10l6.1-.9L12 3.5Z"/></svg>',
  'entity.ai_whatsapp_client.collection' => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20v-1.5C4 16 6.7 14 10 14s6 2 6 4.5V20M10 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm10 9v-1.5c0-1.9-1.3-3.4-3.2-4"/></svg>',
