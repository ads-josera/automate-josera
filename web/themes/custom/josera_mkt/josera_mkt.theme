  'entity.ai_whatsapp_operator_action.collection' => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-9-9"/></svg>',
  'ai_whatsapp_automation.settings' => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8-3-2-.6-.6-1.5 1-1.8-1.5-1.5-1.8 1-1.5-.6L12.8 4h-2l-.6 2-1.5.6-1.8-1L5.4 7.1l1 1.8-.6 1.5L4 12v2l2 .6.6 1.5-1 1.8 1.5 1.5 1.8-1 1.5.6.6 2h2l.6-2 1.5-.6 1.8 1 1.5-1.5-1-1.8.6-1.5 2-.6v-2Z"/></svg>',
];

/**
 * Sections that belong to the configuration group of the navigation.
 *
 * Everything else is day to day work and goes first. A client's user only
 * has access to the first group, so they never see this split.
 */
const JOSERA_MKT_NAV_SETUP = [
  'entity.ai_whatsapp_client.collection',
  'entity.ai_whatsapp_bot.collection',
  'entity.ai_whatsapp_account.collection',
  'ai_whatsapp_automation.multibot_routing',
  'ai_whatsapp_automation.evolution_connections',
  'entity.ai_whatsapp_knowledge_base.collection',
  'entity.ai_whatsapp_knowledge_document.collection',
  'entity.ai_whatsapp_knowledge_chunk.collection',
  'ai_whatsapp_automation.rag_upload',
  'ai_whatsapp_automation.client_mail',
  'ai_whatsapp_automation.settings',
];

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function josera_mkt_preprocess_page(array &$variables): void {
  $variables['josera_logo'] = \Drupal::service('extension.list.theme')->getPath('josera_mkt') . '/images/logo-josera.svg';
  $variables['josera_logo'] = '/' . $variables['josera_logo'];
  $variables['josera_nav'] = josera_mkt_panel_navigation();
  $variables['josera_nav_groups'] = josera_mkt_navigation_groups($variables['josera_nav']);
  $variables['josera_home'] = josera_mkt_home_url();
  $variables['josera_user'] = josera_mkt_account_links();
  // The navigation and the account box differ per user and per current page.
  $variables['#cache']['contexts'][] = 'user';
  $variables['#cache']['contexts'][] = 'url.path';
}

/**
 * Builds the sections of the panel the current user may open.
 *
 * Read from the administration menu, so a section added to
 * ai_whatsapp_automation.links.menu.yml appears here without touching the
 * theme, and one the user has no access to never shows up.
 *
 * @return array<int, array{title: string, url: string, active: bool, icon: \Drupal\Component\Render\MarkupInterface|string}>
 *   Navigation items.
 */
function josera_mkt_panel_navigation(): array {
  $menu_tree = \Drupal::service('menu.link_tree');
  $parameters = new MenuTreeParameters();
  $parameters->setRoot('ai_whatsapp_automation.content')
    ->excludeRoot()
    ->setMaxDepth(1)
    ->onlyEnabledLinks();
  $tree = $menu_tree->transform($menu_tree->load('admin', $parameters), [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $current = \Drupal::routeMatch()->getRouteName();
  $items = [];
  foreach ($tree as $element) {
    if (!$element->access?->isAllowed()) {
      continue;
    }
    $link = $element->link;
    $url = $link->getUrlObject();
    $route = $url->isRouted() ? $url->getRouteName() : '';
    $items[] = [
      'title' => (string) $link->getTitle(),
      'route' => $route,
      'url' => $url->toString(),
      'active' => $route === $current,
      'icon' => \Drupal\Core\Render\Markup::create(JOSERA_MKT_NAV_ICONS[$route] ?? JOSERA_MKT_NAV_ICONS['ai_whatsapp_automation.dashboard']),
    ];
  }

  return $items;
}

/**
 * Splits the navigation into the two groups shown in the side column.
 *
 * @param array<int, array<string, mixed>> $items
 *   Navigation items.
 *
 * @return array<int, array{title: ?string, items: array<int, array<string, mixed>>}>
 *   Groups with at least one item.
 */
function josera_mkt_navigation_groups(array $items): array {
  $work = [];
  $setup = [];
  foreach ($items as $item) {
    if (in_array($item['route'], JOSERA_MKT_NAV_SETUP, TRUE)) {
      $setup[] = $item;
    }
    else {
      $work[] = $item;
    }
  }

  $groups = [];
  if ($work !== []) {
    $groups[] = ['title' => $setup === [] ? NULL : t('Operación'), 'items' => $work];
  }
  if ($setup !== []) {
    $groups[] = ['title' => t('Configuración'), 'items' => $setup];
  }

  return $groups;
}

/**
 * Returns where the wordmark links to: the first section the user may open.
 */
function josera_mkt_home_url(): string {
  $dashboard = Url::fromRoute('ai_whatsapp_automation.dashboard');
  if ($dashboard->access()) {
    return $dashboard->toString();
  }
  $navigation = josera_mkt_panel_navigation();

  return $navigation === [] ? Url::fromRoute('<front>')->toString() : $navigation[0]['url'];
}

/**
 * Returns the account box of the top bar, or NULL for anonymous visitors.
 *
 * @return array{name: string, url: string, logout: string}|null
 *   Account links.
 */
function josera_mkt_account_links(): ?array {
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return NULL;
  }

  return [
    'name' => $account->getDisplayName(),
    'url' => Url::fromRoute('entity.user.canonical', ['user' => $account->id()])->toString(),
    'logout' => Url::fromRoute('user.logout')->toString(),
  ];
}
